# ==============================================================================
# Open Location Resolution Infrastructure - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=location_resolver
POSTGRES_USER=olr_user
POSTGRES_PASSWORD=olr_password

# Database Connection Pool & Performance
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# External Data Source Configuration (OpenCelliD)
# Obtain a free API key at https://opencellid.org/
OPENCELLID_API_KEY=

# Local Ingestion Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=reports/dataset-inspection
