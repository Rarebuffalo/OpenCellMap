# Byte-compiled / optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Packaging
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/
.eggs/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
